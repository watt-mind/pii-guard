# --- Models & weights (download or serve them, never commit) -----------------
models/
checkpoints/
*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.onnx

# --- Data -------------------------------------------------------------------
# Only synthetic, generated data may ever be committed, and only under
# eval/fixtures/. Everything below is local working data.
# data/lexicons/ holds the lexicon fetcher and its manifest; downloads stay local.
data/*
!data/lexicons/
data/lexicons/raw/
eval/generated/
eval/runs/
# Real documents must never enter the repository, not even temporarily.
real/
private/
**/real-data/

# --- Logs & runtime ---------------------------------------------------------
*.log
logs/
tmp/
*.sqlite
*.db

# --- Editors & OS -----------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db

# --- Agent worktrees --------------------------------------------------------
.worktrees/

