# --- Data -------------------------------------------------------------------
# Only synthetic, generated data may ever be committed, and only under
# eval/fixtures/. Everything below is local working data.
# data/lexicons/ holds the lexicon fetcher and its manifest; downloads stay local.
data/*
!data/lexicons/
data/lexicons/raw/
# data/datasets/ holds dataset downloads and fetch-only fixtures (docs/datasets.md).
eval/generated/
eval/runs/
# Real documents must never enter the repository, not even temporarily.
real/
private/
**/real-data/

# --- Logs & runtime ---------------------------------------------------------
*.log
logs/
tmp/
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db

