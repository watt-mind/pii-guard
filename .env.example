# Copy to .env and fill in. Never commit .env.

# Upstream LLM the gateway forwards masked requests to (OpenAI-compatible).
PII_GUARD_UPSTREAM_BASE_URL=
PII_GUARD_UPSTREAM_API_KEY=

# Key for deriving pseudonyms (HMAC). Generate with: openssl rand -hex 32
PII_GUARD_TENANT_KEY=

# Model endpoints (OpenAI-compatible or provider-specific; see docs/models.md).
PII_GUARD_LLM_DETECTOR_URL=
PII_GUARD_LLM_DETECTOR_API_KEY=
PII_GUARD_SAM_URL=

# Corpus generation only (fictional data). Meta Model API.
META_API_KEY=
