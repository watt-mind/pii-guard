# Copy to .env and fill in. Never commit .env.

# Server. Defaults shown; uncomment to change.
# PII_GUARD_HOST=127.0.0.1
# PII_GUARD_PORT=8787
# PII_GUARD_LOG_LEVEL=info
# PII_GUARD_DEFAULT_LANGUAGE=hu
# No authentication by default: keep the API on loopback or behind an authenticating proxy
# (docs/operations.md#exposure-and-authentication). Host headers answered besides localhost,
# 127.0.0.1, [::1] and PII_GUARD_HOST (DNS-rebinding guard); "*" answers any host.
# PII_GUARD_ALLOWED_HOSTS=pii-guard.internal.example
# Bearer token required on every route but /healthz (Authorization: Bearer <token>).
# PII_GUARD_API_TOKEN=

# REST API detection: comma-separated registry names run through the detection pipeline.
# "rules,llm" also masks names, prose addresses and dates of birth (needs the LLM detector).
# PII_GUARD_DETECTORS=rules
# Entity policies on top of the defaults in docs/entities.md (mask | keep | block).
# PII_GUARD_POLICY_OVERRIDES=ORGANIZATION=mask,EMAIL=block

# Upstream LLM the gateway forwards masked requests to (OpenAI-compatible).
PII_GUARD_UPSTREAM_BASE_URL=
PII_GUARD_UPSTREAM_API_KEY=

# Key for deriving pseudonyms (HMAC). Generate with: openssl rand -hex 32
PII_GUARD_TENANT_KEY=

# Limits for values pre-loaded into a session (POST /v1/sessions/{id}/known-values):
# values per session, and characters per value. Values under 3 characters are refused.
# PII_GUARD_KNOWN_VALUES_MAX=1000
# PII_GUARD_KNOWN_VALUES_MAX_LENGTH=256

# Vault: true gives each casing of a value (ALL CAPS, lower case) its own placeholder, so
# unmask restores it exactly; false (default) uses one placeholder and restores the casing
# the value was first written in.
# PII_GUARD_VAULT_CASE_SENSITIVE_PLACEHOLDERS=false
# Most live vault sessions; one more evicts the least recently used (docs/operations.md).
# PII_GUARD_VAULT_MAX_SESSIONS=10000
# Most placeholders in one gateway path / prompt_cache_key / default session; a full one starts
# a new generation (docs/architecture-gateway.md#sessions).
# PII_GUARD_VAULT_MAX_ENTRIES=10000
# Most characters of original values one /v1/unmask call or one gateway response restores;
# more: 413 unmask_output_too_large (docs/operations.md).
# PII_GUARD_UNMASK_MAX_RESTORED_CHARS=1000000

# Image work limits (docs/operations.md): pixels per image (more: 413), images masked at once,
# and the POST /v1/mask/image timeout in seconds (the gateway: PII_GUARD_GATEWAY_IMAGE_TIMEOUT).
# PII_GUARD_IMAGE_MAX_PIXELS=16000000
# PII_GUARD_IMAGE_CONCURRENCY=2
# PII_GUARD_IMAGE_TIMEOUT=120

# Model endpoints (OpenAI-compatible or provider-specific; see docs/models.md).
PII_GUARD_LLM_DETECTOR_URL=
PII_GUARD_LLM_DETECTOR_API_KEY=
# Model name the LLM detector requests; empty uses the built-in default (see docs/models.md).
PII_GUARD_LLM_DETECTOR_MODEL=
# reasoning_effort sent to the model (low|minimal); empty sends none. Baseten Muse Spark Open needs low.
PII_GUARD_LLM_DETECTOR_REASONING_EFFORT=
# Per-request limits of the LLM detector (defaults 4096 tokens, 60 seconds; tokens >= 256).
# Raise both for contract-length documents, e.g. 8192 and 120.
# PII_GUARD_LLM_DETECTOR_MAX_TOKENS=4096
# PII_GUARD_LLM_DETECTOR_TIMEOUT=60
# Muse Glimmer on vLLM: chat_template_kwargs.reasoning_strength (low|medium|high). Use low.
PII_GUARD_LLM_DETECTOR_REASONING_STRENGTH=
PII_GUARD_SAM_URL=

# Corpus generation only (fictional data). Meta Model API.
META_API_KEY=

# LLM detector on Baseten Model APIs: Muse Spark Open, the default endpoint and model (see
# docs/models.md). Put your Baseten key in PII_GUARD_LLM_DETECTOR_API_KEY above. The model is
# PII_GUARD_LLM_DETECTOR_MODEL above (default meta-models/muse-spark-open-1026); set
# PII_GUARD_LLM_DETECTOR_REASONING_EFFORT=low above (environment or .env).
# The live tests (uv run pytest -m live) read the key as BASETEN_API_KEY:
# BASETEN_API_KEY=<your Baseten API key>
