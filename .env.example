# Copy to .env and fill in. Never commit .env.

# Server. Defaults shown; uncomment to change.
# PII_GUARD_HOST=127.0.0.1
# PII_GUARD_PORT=8787
# PII_GUARD_LOG_LEVEL=info
# PII_GUARD_DEFAULT_LANGUAGE=hu
# No authentication by default: keep the API on loopback or behind an authenticating proxy
# (docs/operations.md#exposure-and-authentication). Host headers answered besides localhost,
# 127.0.0.1, [::1] and PII_GUARD_HOST (DNS-rebinding guard); "*" answers any host.
# PII_GUARD_ALLOWED_HOSTS=pii-guard.internal.example
# Bearer token required on every route but /healthz (Authorization: Bearer <token>).
# PII_GUARD_API_TOKEN=

# Processing profile (independent of the masked downstream model). Local-only requires
# provisioned local NER weights, refuses audit/remote segmentation, and never downloads
# weights during inference. See docs/operations.md#local-only-detection.
# PII_GUARD_DETECTION_PROFILE=standard

# REST API detection: comma-separated registry names run through the detection pipeline.
# "rules,llm" also masks names, prose addresses and dates of birth (needs the LLM detector).
# PII_GUARD_DETECTORS=rules
# Entity policies on top of the defaults in docs/entities.md (mask | keep | block).
# PII_GUARD_POLICY_OVERRIDES=ORGANIZATION=mask,EMAIL=block

# Fast-mode NER (docs/models.md#which-ner-model-fast-mode-runs). Unset, the published pii-guard
# checkpoint runs, pinned to release v2.0 and downloaded once into ~/.cache/pii-guard/models.
# PII_GUARD_NER_PUBLISHED_MODEL=watt-mind/pii-guard-ner-xlmr-base
# PII_GUARD_NER_FALLBACK=download

# Upstream LLM the gateway forwards masked requests to (OpenAI-compatible).
PII_GUARD_UPSTREAM_BASE_URL=
PII_GUARD_UPSTREAM_API_KEY=
# Set when the configured upstream is the offline mock (`make demo` sets it): /v1/status
# and Connect then report it as the mock instead of a real-looking URL.
# PII_GUARD_UPSTREAM_MOCK=false

# Key for deriving pseudonyms (HMAC). Generate with: openssl rand -hex 32
PII_GUARD_TENANT_KEY=

# Limits for values pre-loaded into a session (POST /v1/sessions/{id}/known-values):
# values per session, and characters per value. Values under 3 characters are refused.
# PII_GUARD_KNOWN_VALUES_MAX=1000
# PII_GUARD_KNOWN_VALUES_MAX_LENGTH=256

# Vault: true gives each casing of a value (ALL CAPS, lower case) its own placeholder, so
# unmask restores it exactly; false (default) uses one placeholder and restores the casing
# the value was first written in.
# PII_GUARD_VAULT_CASE_SENSITIVE_PLACEHOLDERS=false
# Most live vault sessions; one more evicts the least recently used (docs/operations.md).
# PII_GUARD_VAULT_MAX_SESSIONS=10000
# Most placeholders in one gateway path / prompt_cache_key / default session; a full one starts
# a new generation (docs/architecture-gateway.md#sessions).
# PII_GUARD_VAULT_MAX_ENTRIES=10000
# Most characters of original values one /v1/unmask call or one gateway response restores;
# more: 413 unmask_output_too_large (docs/operations.md).
# PII_GUARD_UNMASK_MAX_RESTORED_CHARS=1000000

# The gateway tells the model that placeholders are opaque tokens to copy as written, when a
# request carries one (docs/architecture-gateway.md#placeholder-note). false: no note.
# PII_GUARD_GATEWAY_PLACEHOLDER_NOTE=true
# Whole streamed-response deadline in seconds (the per-read timeout is separate), and the
# largest non-streamed upstream response body in bytes.
# PII_GUARD_GATEWAY_UPSTREAM_STREAM_TIMEOUT=600
# PII_GUARD_GATEWAY_UPSTREAM_MAX_RESPONSE_BYTES=16777216

# Image work limits (docs/operations.md): pixels per image (more: 413), images masked at once,
# and the POST /v1/mask/image timeout in seconds (the gateway: PII_GUARD_GATEWAY_IMAGE_TIMEOUT).
# PII_GUARD_IMAGE_MAX_PIXELS=16000000
# PII_GUARD_IMAGE_CONCURRENCY=2
# PII_GUARD_IMAGE_TIMEOUT=120

# Whole request-body read deadline in seconds on the REST API (slow-loris guard); past it,
# 408 request_timeout. Raise it for large image bodies on slow links.
# PII_GUARD_BODY_READ_TIMEOUT=30

# Model endpoints (OpenAI-compatible or provider-specific; see docs/models.md).
PII_GUARD_LLM_DETECTOR_URL=
PII_GUARD_LLM_DETECTOR_API_KEY=
# Model name the LLM detector requests; empty uses the built-in default (see docs/models.md).
PII_GUARD_LLM_DETECTOR_MODEL=
# reasoning_effort sent to the model (low|minimal); empty sends none. Baseten Muse Spark Open needs low.
PII_GUARD_LLM_DETECTOR_REASONING_EFFORT=
# Per-request limits of the LLM detector (defaults 4096 tokens, 60 seconds; tokens >= 256).
# Raise both for contract-length documents, e.g. 8192 and 120.
# PII_GUARD_LLM_DETECTOR_MAX_TOKENS=4096
# PII_GUARD_LLM_DETECTOR_TIMEOUT=60
# Muse Glimmer on vLLM: chat_template_kwargs.reasoning_strength (low|medium|high). Use low.
PII_GUARD_LLM_DETECTOR_REASONING_STRENGTH=
PII_GUARD_SAM_URL=

# Corpus generation only (fictional data). Meta Model API.
META_API_KEY=

# LLM detector on Baseten Model APIs: Muse Spark Open, the default endpoint and model (see
# docs/models.md). Put your Baseten key in PII_GUARD_LLM_DETECTOR_API_KEY above. The model is
# PII_GUARD_LLM_DETECTOR_MODEL above (default meta-models/muse-spark-open-1026); set
# PII_GUARD_LLM_DETECTOR_REASONING_EFFORT=low above (environment or .env).
# The live tests (uv run pytest -m live) read the key as BASETEN_API_KEY:
# BASETEN_API_KEY=<your Baseten API key>

# Hosted deployment (opt-in; local behavior is unchanged). Only enable behind Azure
# Easy Auth, with platform headers stripped/replaced and direct origin access impossible.
# PII_GUARD_HOSTED=false
# PII_GUARD_HOSTED_PUBLIC_ORIGIN=https://guard.watt-mind.com
# PII_GUARD_HOSTED_TRUST_EASY_AUTH=false
# Explicit deployment assertion: exactly one worker and one replica, no overlapping revisions.
# PII_GUARD_HOSTED_SINGLE_PROCESS=false
# Secondary anonymous demo abuse signal. Keep off until direct ACA rightmost XFF,
# spoofed/duplicate header handling and platform access-log privacy are verified live.
# Allowed: off | aca_xff_rightmost (no client address or other header fallback).
# PII_GUARD_HOSTED_CLIENT_IP_SOURCE=off
# PII_GUARD_HOSTED_MAX_PRINCIPALS=256
# Anonymous demo runtimes, a separate pool from signed-in owners.
# PII_GUARD_HOSTED_MAX_GUEST_RUNTIMES=8
# PII_GUARD_HOSTED_RUNTIME_TTL=3600
# PII_GUARD_HOSTED_MAX_SESSIONS=20
# PII_GUARD_HOSTED_MAX_BODY_BYTES=32768
# PII_GUARD_HOSTED_MAX_OUTPUT_TOKENS=8192
# PII_GUARD_HOSTED_REQUEST_TIMEOUT=180
# PII_GUARD_HOSTED_MODELS=muse-spark-1.3
# Sponsored is disabled by default. Allocate only after reconciling provider spend.
# Claim directory MUST exist on durable storage surviving container replacement.
# Startup exclusively consumes the allocation ID; reused IDs cannot sponsor any work.
# PII_GUARD_HOSTED_SPONSORED_MICRODOLLARS=0
# PII_GUARD_HOSTED_SPONSORED_ALLOCATION_ID=
# PII_GUARD_HOSTED_ALLOCATION_DIRECTORY=
# Kill switch: creating this absolute path disables sponsored work until restart.
# PII_GUARD_HOSTED_SPONSORED_KILL_SWITCH_PATH=
# PII_GUARD_HOSTED_ALLOCATION_EXPIRES_AT=
# Durable monetary allowance (optional `hosted-azure` extra). Marker stays the default.
# Azure mode READS an operator-funded existing <environment>.json; never creates/refills.
# Existing sponsored amount/allocation ID/expiry above pin the exact approved blob values.
# PII_GUARD_HOSTED_SPEND_STORE=marker
# PII_GUARD_HOSTED_SPEND_ACCOUNT_URL=https://youraccount.blob.core.windows.net
# PII_GUARD_HOSTED_SPEND_CONTAINER=sponsored-allowance
# PII_GUARD_HOSTED_SPEND_ENVIRONMENT=dev
# Optional user-assigned managed identity client ID; unset uses system-assigned identity.
# PII_GUARD_HOSTED_SPEND_MANAGED_IDENTITY_CLIENT_ID=
# Conservative operator-verified upper bounds for every allowlisted model, including reasoning.
# PII_GUARD_HOSTED_INPUT_MICRODOLLARS_PER_TOKEN=5
# PII_GUARD_HOSTED_OUTPUT_MICRODOLLARS_PER_TOKEN=30
# Hosted image masking (ADR 0014): signed-in owners only, in memory, Tesseract + the on-device
# segmenter (PII_GUARD_SEGMENTER must be local or unset; hybrid/sam-api are refused). With it
# on, /readyz needs OCR and the local segmenter. Upload, pixel, deadline and daily-count limits.
# PII_GUARD_HOSTED_IMAGES=true
# PII_GUARD_HOSTED_MAX_IMAGE_BYTES=4194304
# PII_GUARD_HOSTED_IMAGE_MAX_PIXELS=8000000
# PII_GUARD_HOSTED_IMAGE_TIMEOUT=60
# PII_GUARD_HOSTED_USER_IMAGES_PER_DAY=20
# PII_GUARD_HOSTED_GLOBAL_IMAGES_PER_DAY=500

# Local metadata; persist this private directory and stable encryption key.
PII_GUARD_PROJECT_STATE_PATH=~/.local/share/pii-guard/projects/state.sqlite3
# Hosted durable encrypted configuration snapshots; local defaults remain SQLite.
# Precreate a private container and run the explicit operator initializer once; no auto-create.
PII_GUARD_HOSTED_PROJECT_STORE=sqlite
# PII_GUARD_HOSTED_PROJECT_ACCOUNT_URL=https://<account>.blob.core.windows.net
PII_GUARD_HOSTED_PROJECT_CONTAINER=project-configuration
PII_GUARD_HOSTED_PROJECT_ENVIRONMENT=dev
# PII_GUARD_HOSTED_PROJECT_MANAGED_IDENTITY_CLIENT_ID=
