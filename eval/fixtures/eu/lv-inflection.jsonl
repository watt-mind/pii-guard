{"id": "lv-inflection-0001", "language": "lv", "text": "Vakar runāju ar Valteru Krastu. Valtera Krasta piedāvājums mums patika, tāpēc nosūtījām Valteram Krastam līgumu.", "spans": [{"start": 16, "end": 30, "entity_type": "PERSON", "text": "Valteru Krastu"}, {"start": 32, "end": 46, "entity_type": "PERSON", "text": "Valtera Krasta"}, {"start": 88, "end": 104, "entity_type": "PERSON", "text": "Valteram Krastam"}], "meta": {"kind": "inflection", "tags": ["acc", "gen", "dat"]}}
{"id": "lv-inflection-0002", "language": "lv", "text": "Dokumentus parakstīja Inga Rudzīte. Ingai Rudzītei tika nosūtīta kopija, bet Ingas Rudzītes vietniece vēl gaida atbildi.", "spans": [{"start": 22, "end": 34, "entity_type": "PERSON", "text": "Inga Rudzīte"}, {"start": 36, "end": 50, "entity_type": "PERSON", "text": "Ingai Rudzītei"}, {"start": 77, "end": 91, "entity_type": "PERSON", "text": "Ingas Rudzītes"}], "meta": {"kind": "inflection", "tags": ["dat", "gen"]}}
