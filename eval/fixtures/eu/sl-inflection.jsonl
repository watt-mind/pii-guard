{"id": "sl-inflection-0001", "language": "sl", "text": "Včeraj sem govoril z Lovrom Perkom. Predlog Lovra Perka nam je bil všeč, zato smo Lovru Perku poslali pogodbo.", "spans": [{"start": 21, "end": 34, "entity_type": "PERSON", "text": "Lovrom Perkom"}, {"start": 44, "end": 55, "entity_type": "PERSON", "text": "Lovra Perka"}, {"start": 82, "end": 93, "entity_type": "PERSON", "text": "Lovru Perku"}], "meta": {"kind": "inflection", "tags": ["ins", "gen", "dat"]}}
{"id": "sl-inflection-0002", "language": "sl", "text": "Dokument je podpisala Mojca Bergant. Mojci Bergant smo poslali kopijo, namestnica Mojce Bergant pa še čaka na odgovor.", "spans": [{"start": 22, "end": 35, "entity_type": "PERSON", "text": "Mojca Bergant"}, {"start": 37, "end": 50, "entity_type": "PERSON", "text": "Mojci Bergant"}, {"start": 82, "end": 95, "entity_type": "PERSON", "text": "Mojce Bergant"}], "meta": {"kind": "inflection", "tags": ["dat", "gen"]}}
