{"id": "ga-inflection-0001", "language": "ga", "text": "Shínigh Seán Ó Briain an conradh. Thug muid cóip do Sheán Ó Briain, agus tá teach Sheáin Uí Bhriain díolta anois.", "spans": [{"start": 8, "end": 21, "entity_type": "PERSON", "text": "Seán Ó Briain"}, {"start": 52, "end": 66, "entity_type": "PERSON", "text": "Sheán Ó Briain"}, {"start": 82, "end": 99, "entity_type": "PERSON", "text": "Sheáin Uí Bhriain"}], "meta": {"kind": "inflection", "tags": ["lenition", "genitive"]}}
{"id": "ga-inflection-0002", "language": "ga", "text": "A Sheáin, an bhfuil tú ag teacht? Tá Máire Ní Bhriain ag fanacht.", "spans": [{"start": 2, "end": 8, "entity_type": "PERSON", "text": "Sheáin"}, {"start": 37, "end": 53, "entity_type": "PERSON", "text": "Máire Ní Bhriain"}], "meta": {"kind": "inflection", "tags": ["vocative"]}}
{"id": "ga-inflection-0003", "language": "ga", "text": "Is í Gráinne Ní Dhónaill an t-iarratasóir. Bhí Ní Dhónaill i láthair sa chúirt.", "spans": [{"start": 5, "end": 24, "entity_type": "PERSON", "text": "Gráinne Ní Dhónaill"}, {"start": 47, "end": 58, "entity_type": "PERSON", "text": "Ní Dhónaill"}], "meta": {"kind": "inflection", "tags": ["standalone-surname"]}}
{"id": "ga-inflection-0004", "language": "ga", "text": "A Phádraig, labhair mé le Tomás Mac Giolla inné.", "spans": [{"start": 2, "end": 10, "entity_type": "PERSON", "text": "Phádraig"}, {"start": 26, "end": 42, "entity_type": "PERSON", "text": "Tomás Mac Giolla"}], "meta": {"kind": "inflection", "tags": ["lenition"]}}
