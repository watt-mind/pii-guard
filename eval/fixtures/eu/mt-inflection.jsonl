{"id": "mt-inflection-0001", "language": "mt", "text": "Il-kuntratt ġie ffirmat mis-Sur Borg u mis-Sinjura Maria Cassar.", "spans": [{"start": 32, "end": 36, "entity_type": "PERSON", "text": "Borg"}, {"start": 51, "end": 63, "entity_type": "PERSON", "text": "Maria Cassar"}], "meta": {"kind": "inflection", "tags": ["title"]}}
{"id": "mt-inflection-0002", "language": "mt", "text": "Għażiż Kevin, tista' tibgħat ir-rapport lil Rita Spiteri? Skont Spiteri jonqos l-anness.", "spans": [{"start": 7, "end": 12, "entity_type": "PERSON", "text": "Kevin"}, {"start": 44, "end": 56, "entity_type": "PERSON", "text": "Rita Spiteri"}, {"start": 64, "end": 71, "entity_type": "PERSON", "text": "Spiteri"}], "meta": {"kind": "inflection", "tags": ["given-only", "standalone-surname"]}}
{"id": "mt-inflection-0003", "language": "mt", "text": "Skont Paul Micallef, il-laqgħa ma' Micallef u ma' Galea ġiet posposta.", "spans": [{"start": 6, "end": 19, "entity_type": "PERSON", "text": "Paul Micallef"}, {"start": 35, "end": 43, "entity_type": "PERSON", "text": "Micallef"}, {"start": 50, "end": 55, "entity_type": "PERSON", "text": "Galea"}], "meta": {"kind": "inflection", "tags": ["elision"]}}
{"id": "mt-inflection-0004", "language": "mt", "text": "Il-karozza ta' Anna Mifsud kienet ipparkjata quddiem id-dar ta' Mifsud.", "spans": [{"start": 15, "end": 26, "entity_type": "PERSON", "text": "Anna Mifsud"}, {"start": 64, "end": 70, "entity_type": "PERSON", "text": "Mifsud"}], "meta": {"kind": "inflection", "tags": ["standalone-surname"]}}
