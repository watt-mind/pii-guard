{
  "version": 1,
  "description": "Exact personal-data regions of the fictional documents in manifest.json, keyed by image SHA-256. Known from the composition step (where each value, portrait, signature and MRZ was drawn), not drawn by hand.",
  "box_format": "[x1, y1, x2, y2] as fractions of the image width and height",
  "method": "Pillow text bounding boxes (+2 px), pasted portrait rectangles, the ink bounding box of each pasted signature (+3 px) and the MRZ lines (+3 px).",
  "region_types": {
    "portrait": "the generated face photo",
    "signature": "a generated handwritten signature",
    "mrz": "the machine-readable zone (all lines, valid check digits)",
    "text": "one personal-data value; 'entity' says which kind"
  },
  "unscored_types": {
    "stamp": "a generated rubber stamp (STAMP is kept by the default policy)",
    "overprint": "the MINTA / SPECIMEN marks (whole image)"
  },
