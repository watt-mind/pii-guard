# syntax=docker/dockerfile:1
# Hosted build: text plus local-only image masking (ADR 0014). Keep the self-hosted Dockerfile
# independent. Images use Tesseract and the on-device YuNet segmenter only; never SAM.
FROM ghcr.io/astral-sh/uv:0.13.6-python3.12-trixie-slim@sha256:bf889bda77474aa50c351caf1538b855ef2b7a30add45f26ca50dcb6ade06402 AS python-build
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=0
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE NOTICE ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --no-dev --extra ner --extra hosted-azure --extra ocr --extra local-vision --no-install-project
COPY src ./src
COPY eval/results ./eval/results
COPY docs/benchmarks/config.json ./docs/benchmarks/config.json
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --no-dev --extra ner --extra hosted-azure --extra ocr --extra local-vision --no-editable \
    && .venv/bin/python -m pii_guard.eval.report_cli --print-index > /app/benchmarks-index.json
# Uses the existing pinned checkpoint + SHA-256 verifier, and warms a CPU forward pass.
RUN .venv/bin/python -c "import shutil; from pii_guard.detect.ner_resolve import PUBLISHED, ensure, resolve; from pii_guard.detect.ner import NerDetector; p=ensure(resolve(published=PUBLISHED.repo_id + '@' + PUBLISHED.revision, fallback='download')); shutil.copytree(p, '/app/models/ner'); NerDetector(model='/app/models/ner', device='cpu')"
# The YuNet face/ID-photo model (0.23 MB, MIT), fetched from its pinned URL and checked against
# its pinned SHA-256 (pii_guard.visual.segment.YUNET); the build fails on a mismatch.
RUN PII_GUARD_MODEL_DIR=/app/models .venv/bin/python -m pii_guard.visual.segment fetch

FROM node:24-trixie-slim@sha256:89c5244bc22a9bc3287d89ebc7e49b9cb5bb84cd40e6175ac3421d5a9f68b95a AS ui-build
WORKDIR /ui
RUN npm install --global pnpm@12.10.1
COPY ui/package.json ui/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY ui ./
COPY --from=python-build /app/benchmarks-index.json /app/benchmarks-index.json
ENV VITE_PII_GUARD_MODE=api VITE_PII_GUARD_HOSTED=true PII_GUARD_BENCHMARKS_INDEX=/app/benchmarks-index.json
RUN pnpm build

FROM python:3.12-slim-trixie@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 AS runtime
# Tesseract reads the text in images so it can be masked; without it /readyz fails while hosted
# images are on (ADR 0006). The packs match the language packs, plus OSD for orientation.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        tesseract-ocr tesseract-ocr-osd tesseract-ocr-eng tesseract-ocr-hun tesseract-ocr-deu \
        tesseract-ocr-pol \
    && rm -rf /var/lib/apt/lists/*
# Mount a private filesystem here to retain configuration across container replacement.
# Without a mount this directory lasts only as long as the container's writable layer.
RUN groupadd --system --gid 10001 piiguard \
    && useradd --system --uid 10001 --gid piiguard --no-create-home piiguard \
    && install -d -m 0700 -o piiguard -g piiguard /var/lib/pii-guard/projects
WORKDIR /app
COPY --from=python-build /app/.venv /app/.venv
COPY --from=python-build /app/models /app/models
COPY --from=ui-build /ui/dist /app/.venv/lib/python3.12/site-packages/pii_guard/_ui
COPY deploy/azure/entrypoint.py /app/entrypoint.py
ENV PATH=/app/.venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \
    PII_GUARD_HOST=0.0.0.0 PII_GUARD_PORT=8787 \
    PII_GUARD_HOSTED=true PII_GUARD_HOSTED_SINGLE_PROCESS=true \
    PII_GUARD_PROJECT_STATE_PATH=/var/lib/pii-guard/projects/state.sqlite3 \
    PII_GUARD_NER_MODEL=/app/models/ner PII_GUARD_NER_DEVICE=cpu \
    PII_GUARD_DETECTORS=rules,ner PII_GUARD_NER_FALLBACK=off \
    PII_GUARD_MODEL_DIR=/app/models PII_GUARD_SEGMENTER=local PII_GUARD_IMAGE_CONCURRENCY=1 \
    PII_GUARD_TRAFFIC_LOG=off PII_GUARD_METRICS=false
USER piiguard
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
    CMD ["python", "-c", "import json,urllib.request; r=json.load(urllib.request.urlopen('http://127.0.0.1:8787/healthz',timeout=3)); assert r['ner']=='ready'"]
CMD ["python", "/app/entrypoint.py"]
