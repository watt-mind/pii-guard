# syntax=docker/dockerfile:1
# Hosted build: text plus local-only image masking (ADR 0014). Keep the self-hosted Dockerfile
# independent. Images use Tesseract, the on-device YuNet segmenter and the pinned YOLOS-tiny
# signature detector only; never SAM (ADR 0014, LAB-1444). The `sam` extra (Meta's SAM 3.1
# output parser, LAB-1665) is installed so the image matches the self-hosted one; it makes no
# calls and does not enable SAM.
# python-deps ends with the dependency-only venv. The runtime copies it as its own layer, which
# keeps its digest across src-only changes; only the small project layer changes (LAB-1449).
FROM ghcr.io/astral-sh/uv:0.13.6-python3.12-trixie-slim@sha256:bf889bda77474aa50c351caf1538b855ef2b7a30add45f26ca50dcb6ade06402 AS python-deps
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=0
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE NOTICE ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --no-dev --extra ner --extra hosted-azure --extra ocr --extra local-vision --extra sam --no-install-project

# The pinned NER checkpoint (about 1 GB) is fetched before `COPY src`, from only the modules that
# hold its pin and SHA-256 verifier, so a change elsewhere in src/ reuses this layer from the
# registry cache (deploy/azure/acr_build.sh, LAB-1446). Changing the pin re-fetches it. The
# runtime copies it from this stage, so its layer does not change with src either (LAB-1449).
FROM python-deps AS ner-model
COPY src/pii_guard/__init__.py src/pii_guard/types.py /app/pin/pii_guard/
COPY src/pii_guard/detect/__init__.py src/pii_guard/detect/ner_resolve.py /app/pin/pii_guard/detect/
RUN mkdir -p /app/models && PYTHONPATH=/app/pin .venv/bin/python -c "import shutil; from pathlib import Path; from pii_guard.detect.ner_resolve import PUBLISHED, ensure, resolve; p=ensure(resolve(published=PUBLISHED.repo_id + '@' + PUBLISHED.revision, fallback='download'), base=Path('/tmp/ner-fetch')); shutil.move(p, '/app/models/ner')" \
    && rm -rf /tmp/ner-fetch /app/pin

FROM ner-model AS python-build
COPY src ./src
COPY eval/results ./eval/results
COPY docs/benchmarks/config.json docs/benchmarks/colours.json ./docs/benchmarks/
# Installs only the project (the dependencies are already synced) and byte-compiles only its own
# package, so no dependency file is rewritten. venv_layer.py then copies what the install added
# to the venv into /app/venv-project, and fails if the install removed anything.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=deploy/azure/venv_layer.py,target=/tmp/venv_layer.py \
    --mount=type=bind,from=python-deps,source=/app/.venv,target=/tmp/venv-deps \
    UV_COMPILE_BYTECODE=0 uv sync --locked --no-dev --extra ner --extra hosted-azure --extra ocr --extra local-vision --extra sam --no-editable \
    && .venv/bin/python -m compileall -q -j 0 .venv/lib/python3.12/site-packages/pii_guard \
    && .venv/bin/python /tmp/venv_layer.py /tmp/venv-deps /app/.venv /app/venv-project \
    && .venv/bin/python -m pii_guard.eval.report_cli --print-index > /app/benchmarks-index.json
# Loads the fetched checkpoint with this commit's detector and warms a CPU forward pass.
RUN .venv/bin/python -c "from pii_guard.detect.ner import NerDetector; NerDetector(model='/app/models/ner', device='cpu')"
# The YuNet face/ID-photo model (0.23 MB, MIT) and the YOLOS-tiny signature detector (26 MB,
# Apache-2.0, safetensors), each fetched from its pinned URL and checked against its pinned
# SHA-256 (pii_guard.visual.segment.YUNET, pii_guard.visual.segmenters.SIGNATURE_DETECTOR); the
# build fails on a mismatch. The detector is then loaded offline once, as readiness does.
# The runtime copies the NER checkpoint from ner-model and only these files from here, so this
# fails if a step above changed the checkpoint or left anything else in /app/models.
RUN --mount=type=bind,from=ner-model,source=/app/models/ner,target=/tmp/ner-pinned \
    PII_GUARD_MODEL_DIR=/app/models .venv/bin/python -m pii_guard.visual.segment fetch \
    && PII_GUARD_MODEL_DIR=/app/models .venv/bin/python -m pii_guard.visual.segmenters fetch \
    && PII_GUARD_MODEL_DIR=/app/models HF_HUB_OFFLINE=1 .venv/bin/python -c "from pii_guard.visual.segmenters import SignatureDetector; SignatureDetector()" \
    && test "$(ls -A /app/models | tr '\n' ' ')" = "face_detection_yunet_2023mar.onnx ner yolos-tiny-signature " \
    && test "$(ls -A /app/models/yolos-tiny-signature | tr '\n' ' ')" = "config.json model.safetensors preprocessor_config.json " \
    && diff -r --no-dereference /tmp/ner-pinned /app/models/ner

FROM node:24-trixie-slim@sha256:89c5244bc22a9bc3287d89ebc7e49b9cb5bb84cd40e6175ac3421d5a9f68b95a AS ui-build
WORKDIR /ui
RUN npm install --global pnpm@12.10.1
COPY ui/package.json ui/pnpm-lock.yaml ui/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY ui ./
# The #api reference bundles the generated spec from ../docs (LAB-1586).
COPY docs/openapi.json /docs/openapi.json
COPY --from=python-build /app/benchmarks-index.json /app/benchmarks-index.json
# robots.txt: "allow" only for the public production build; the default keeps crawlers out (docs/hosted.md).
ARG VITE_PII_GUARD_ROBOTS=disallow
# The landing's demo video slot: hidden while the URL is empty (docs/hosted.md).
ARG VITE_PII_GUARD_DEMO_VIDEO_URL=""
ARG VITE_PII_GUARD_DEMO_VIDEO_POSTER=""
ENV VITE_PII_GUARD_MODE=api VITE_PII_GUARD_HOSTED=true VITE_PII_GUARD_ROBOTS=$VITE_PII_GUARD_ROBOTS PII_GUARD_BENCHMARKS_INDEX=/app/benchmarks-index.json \
    VITE_PII_GUARD_DEMO_VIDEO_URL=$VITE_PII_GUARD_DEMO_VIDEO_URL VITE_PII_GUARD_DEMO_VIDEO_POSTER=$VITE_PII_GUARD_DEMO_VIDEO_POSTER
RUN pnpm build

FROM python:3.12-slim-trixie@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 AS runtime
# Tesseract reads the text in images so it can be masked; without it /readyz fails while hosted
# images are on (ADR 0006). The packs match the language packs, plus OSD for orientation.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        tesseract-ocr tesseract-ocr-osd tesseract-ocr-eng tesseract-ocr-hun tesseract-ocr-deu \
        tesseract-ocr-pol \
    && rm -rf /var/lib/apt/lists/*
# Mount a private filesystem here to retain configuration across container replacement.
# Without a mount this directory lasts only as long as the container's writable layer.
RUN groupadd --system --gid 10001 piiguard \
    && useradd --system --uid 10001 --gid piiguard --no-create-home piiguard \
    && install -d -m 0700 -o piiguard -g piiguard /var/lib/pii-guard/projects
WORKDIR /app
COPY --from=python-deps /app/.venv /app/.venv
COPY --from=python-build /app/venv-project /app/.venv
COPY --from=ner-model /app/models/ner /app/models/ner
COPY --from=python-build /app/models/face_detection_yunet_2023mar.onnx /app/models/
COPY --from=python-build /app/models/yolos-tiny-signature /app/models/yolos-tiny-signature
COPY --from=ui-build /ui/dist /app/.venv/lib/python3.12/site-packages/pii_guard/_ui
COPY deploy/azure/entrypoint.py /app/entrypoint.py
ENV PATH=/app/.venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \
    PII_GUARD_HOST=0.0.0.0 PII_GUARD_PORT=8787 \
    PII_GUARD_HOSTED=true PII_GUARD_HOSTED_SINGLE_PROCESS=true \
    PII_GUARD_PROJECT_STATE_PATH=/var/lib/pii-guard/projects/state.sqlite3 \
    PII_GUARD_NER_MODEL=/app/models/ner PII_GUARD_NER_DEVICE=cpu \
    PII_GUARD_DETECTORS=rules,ner PII_GUARD_NER_FALLBACK=off \
    PII_GUARD_MODEL_DIR=/app/models PII_GUARD_SEGMENTER=local PII_GUARD_IMAGE_CONCURRENCY=1 \
    PII_GUARD_TRAFFIC_LOG=off PII_GUARD_METRICS=false
USER piiguard
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
    CMD ["python", "-c", "import json,urllib.request; r=json.load(urllib.request.urlopen('http://127.0.0.1:8787/healthz',timeout=3)); assert r['ner']=='ready'"]
CMD ["python", "/app/entrypoint.py"]
